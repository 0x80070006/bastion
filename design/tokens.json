{
  "$comment": "Single source of design tokens for mobile and desktop. Edit here, then run `pnpm tokens:gen`. See docs/DECISIONS.md ADR-0013. Tactical console palette: near-black ground, one accent (phosphor green) shared with the OK status, amber for alerts, red for critical.",
  "color": {
    "background": "#0B0E11",
    "surface": "#10151A",
    "surfaceRaised": "#161C22",
    "border": "#1F272E",
    "borderActive": "#2D3842",
    "textPrimary": "#E6EAED",
    "textSecondary": "#9AA6B0",
    "textTertiary": "#7B8792",
    "accent": "#3DDC97",
    "onAccent": "#04130C",
    "danger": "#F0524F",
    "success": "#3DDC97",
    "warning": "#E5A00D",
    "inactive": "#6B7782"
  },
  "spacing": {
    "xxs": 4,
    "xs": 8,
    "sm": 12,
    "md": 16,
    "lg": 24,
    "xl": 32,
    "xxl": 48
  },
  "radius": {
    "sm": 2,
    "md": 3,
    "lg": 4
  },
  "border": {
    "width": 1
  },
  "font": {
    "sans": "IBM Plex Sans",
    "mono": "JetBrains Mono"
  },
  "typeScale": {
    "display": { "size": 32, "lineHeight": 40, "weight": 600, "tracking": -0.4 },
    "title": { "size": 20, "lineHeight": 28, "weight": 600, "tracking": -0.2 },
    "body": { "size": 15, "lineHeight": 22, "weight": 400, "tracking": 0 },
    "label": { "size": 13, "lineHeight": 18, "weight": 500, "tracking": 0.1 },
    "caption": { "size": 12, "lineHeight": 16, "weight": 400, "tracking": 0.2 }
  },
  "motion": {
    "fast": 120,
    "standard": 160,
    "slow": 200,
    "easing": [0.0, 0.0, 0.2, 1.0]
  },
  "touchTarget": {
    "min": 48
  }
}
