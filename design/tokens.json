{
  "$comment": "Single source of design tokens for mobile and desktop. Edit here, then run `pnpm tokens:gen`. See docs/DECISIONS.md ADR-0013.",
  "color": {
    "background": "#0A0A0B",
    "surface": "#111113",
    "surfaceRaised": "#17171A",
    "border": "#24242A",
    "borderActive": "#34343C",
    "textPrimary": "#EDEDEF",
    "textSecondary": "#9A9AA3",
    "textTertiary": "#62626B",
    "accent": "#C9B27C",
    "onAccent": "#0A0A0B",
    "danger": "#C5574F",
    "success": "#5FA37A",
    "warning": "#C79A4A"
  },
  "spacing": {
    "xxs": 4,
    "xs": 8,
    "sm": 12,
    "md": 16,
    "lg": 24,
    "xl": 32,
    "xxl": 48
  },
  "radius": {
    "sm": 6,
    "md": 10,
    "lg": 12
  },
  "border": {
    "width": 1
  },
  "font": {
    "sans": "Inter Tight",
    "mono": "JetBrains Mono"
  },
  "typeScale": {
    "display": { "size": 32, "lineHeight": 40, "weight": 600, "tracking": -0.4 },
    "title": { "size": 20, "lineHeight": 28, "weight": 600, "tracking": -0.2 },
    "body": { "size": 15, "lineHeight": 22, "weight": 400, "tracking": 0 },
    "label": { "size": 13, "lineHeight": 18, "weight": 500, "tracking": 0.1 },
    "caption": { "size": 12, "lineHeight": 16, "weight": 400, "tracking": 0.2 }
  },
  "motion": {
    "fast": 120,
    "standard": 160,
    "slow": 200,
    "easing": [0.0, 0.0, 0.2, 1.0]
  },
  "touchTarget": {
    "min": 48
  }
}
